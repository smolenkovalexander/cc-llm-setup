@echo off
REM Запуск локального прокси LiteLLM (127.0.0.1:4000)
REM Скопируй этот файл в start-proxy.cmd. Путь подставляется автоматически,
REM если репозиторий клонирован в %USERPROFILE%\cc-llm-setup (раскладка по умолчанию).
REM Клон в другом месте — впиши свой путь в PROXY_DIR вручную.

set "PROXY_DIR=%USERPROFILE%\cc-llm-setup"

REM PYTHONIOENCODING=utf-8 обязателен: без него litellm падает при печати баннера
REM в консоли cp1251 (UnicodeEncodeError -> Application startup failed)
cd /d "%PROXY_DIR%"
set "PYTHONIOENCODING=utf-8"

REM --host 127.0.0.1: прокси доступен только с этого компьютера
start "litellm-proxy" /min "%PROXY_DIR%\venv\Scripts\litellm.exe" --config "%PROXY_DIR%\config-azure.yaml" --port 4000 --host 127.0.0.1

echo LiteLLM proxy started on http://127.0.0.1:4000
