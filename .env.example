# Переменные окружения для Claude Code
# Скопируй в ~/.env (домашняя папка пользователя) и подставь значения.

# Прокси LiteLLM — Claude Code будет слать запросы сюда (для cc-proxy)
ANTHROPIC_BASE_URL=http://127.0.0.1:4000

# Любой непустой токен (реальный ключ не нужен — авторизация в прокси)
ANTHROPIC_AUTH_TOKEN=YOUR_LITELLM_VIRTUAL_KEY_OR_ANY_NONEMPTY_STRING

# Модель по умолчанию: DeepSeek V4.1 Flash — повседневная работа
ANTHROPIC_MODEL=deepseek-flash

# Маппинг уровней моделей Claude Code:
# opus = самые сложные задачи (DeepSeek V4 Pro)
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
# sonnet = обычная работа (V4.1 Flash)
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash
# haiku = лёгкие задачи (V4.1 Flash)
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash

# Модель для сабагентов
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash

# Опционально
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENABLE_TOOL_SEARCH=true

# ВАЖНО про имена моделей в этом файле:
#   * они должны совпадать с model_name в config-azure.yaml — прокси ищет модель
#     по точному имени и на незнакомое отвечает 400 Invalid model name;
#   * суффикс [1m] (вариант модели с контекстом 1M токенов) здесь указывать НЕЛЬЗЯ:
#     его понимает только прямой DeepSeek API. Лончер cc-ds подставляет [1m]
#     сам, поверх этого файла, — поэтому cc-ds работает и с этими именами.

# Корпоративный Claude через DIAL — опционально, требует VPN:
# /model claude-sonnet-4-6  (модель должна быть в config-azure.yaml)
