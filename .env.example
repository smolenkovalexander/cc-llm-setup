# Переменные окружения для Claude Code
# Скопируй в ~/.env (домашняя папка пользователя) и подставь значения

# Прокси LiteLLM — Claude Code будет слать запросы сюда
ANTHROPIC_BASE_URL=http://127.0.0.1:4000

# Любой непустой токен (реальный ключ не нужен — авторизация в прокси)
ANTHROPIC_AUTH_TOKEN=YOUR_LITELLM_VIRTUAL_KEY_OR_ANY_NONEMPTY_STRING

# Модель по умолчанию для основной работы
ANTHROPIC_MODEL=deepseek-v4-pro

# Маппинг уровней моделей Claude Code → реальные модели прокси
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# Модель для сабагентов (дешевле)
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash

# Опционально
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENABLE_TOOL_SEARCH=true
