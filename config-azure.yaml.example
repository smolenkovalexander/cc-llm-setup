model_list:
  # DeepSeek через Anthropic-совместимый эндпоинт (основная дешёвая модель)
  - model_name: deepseek-v4-pro
    litellm_params:
      model: anthropic/deepseek-v4-pro
      api_base: https://api.deepseek.com/anthropic
      api_key: YOUR_DEEPSEEK_API_KEY

  # DeepSeek Flash — для фоновых задач и сабагентов
  - model_name: deepseek-flash
    litellm_params:
      model: anthropic/deepseek-flash
      api_base: https://api.deepseek.com/anthropic
      api_key: YOUR_DEEPSEEK_API_KEY

  # Claude Sonnet через EPAM DIAL (корпоративный шлюз)
  - model_name: claude-sonnet-4-6
    litellm_params:
      model: azure/anthropic.claude-sonnet-4-6
      api_base: https://ai-proxy.lab.epam.com
      api_key: YOUR_DIAL_TOKEN
      api_version: ""

  # Claude Haiku через EPAM DIAL
  - model_name: claude-haiku-4-5
    litellm_params:
      model: azure/anthropic.claude-haiku-4-5-20251001-v1:0
      api_base: https://ai-proxy.lab.epam.com
      api_key: YOUR_DIAL_TOKEN
      api_version: ""

litellm_settings:
  drop_params: true
  callbacks:
    - strip_cache.strip_cache_handler

# --- Совместимость версий ------------------------------------------------------
# Версия LiteLLM зафиксирована в requirements.txt (1.99.0) — на ней эта
# конфигурация проверена, блока general_settings здесь нет и не требуется.
#
# Если обновляешь LiteLLM: новые версии отказываются стартовать без настроек
# аутентификации и требуют либо master_key, либо явное разрешение слабого ключа.
# Точное имя флага смотри в тексте ошибки при запуске; обычно достаточно:
#
# general_settings:
#   dangerously_permit_weak_or_unset_master_key: true
#
# Это безопасно ровно до тех пор, пока прокси слушает только 127.0.0.1
# (см. --host в start-proxy.cmd). При выходе на другие интерфейсы задай master_key.
